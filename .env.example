# 拾知 · 学习助手 配置模板：复制为 .env 后填写
# Copy-Item .env.example .env
# 填好后重启工作站：网页「偏好与权限 → 电脑服务控制台 → 停止拾知后台」，再双击 启动拾知.cmd。
# 密钥只由服务端读取，不下发浏览器；.env 已被 .gitignore 忽略。

HOST=127.0.0.1
PORT=4317
# 仅当 HOST 不是 127.0.0.1 / localhost 时才需要：16–128 位字母、数字、下划线或短横线
# ACCESS_TOKEN=

# OpenAI 兼容的 base_url。项目会自动拼接 /chat/completions，所以不要写到 /chat/completions。
# 官方 DeepSeek 填 https://api.deepseek.com（不要带 /v1）。
AI_BASE_URL=https://api.deepseek.com

# 服务商密钥。官方 DeepSeek 到 https://platform.deepseek.com/api_keys 申请，形如 sk-xxxxxx。
AI_API_KEY=

# 模型名称，必须与服务商提供的标识完全一致。
# 官方 DeepSeek 可选：deepseek-flash（DeepSeek-V4.1-Flash，支持图像理解）
#                  deepseek-v4-pro（不支持图像理解，圈选/OCR 会报错）
AI_MODEL=deepseek-flash

# 可选：思考模式开关（DeepSeek 默认 enabled，思维链会计入输出 token）。
# disabled = 关闭思考模式省 token；enabled = 保留；留空则不发送该参数。
AI_THINKING=disabled

# 可选：同一服务商的语音转写模型（走 /audio/transcriptions）。
# 官方 DeepSeek 未提供该接口，留空即可。
AI_TRANSCRIBE_MODEL=